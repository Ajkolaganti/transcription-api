# HuggingFace Token for pyannote models
# Get from: https://huggingface.co/settings/tokens
# Accept terms: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# API Key for endpoint authentication (optional)
# If set, all /transcribe requests must include header: X-API-Key: <your_key>
# Leave empty to allow unauthenticated access (open API)
API_KEY=

# Maximum upload file size in MB (default: 100)
MAX_FILE_SIZE_MB=100

# Allowed CORS origins (comma-separated)
# Use * to allow all origins, or restrict to specific domains:
# Example: https://yourapp.com,https://api.yourapp.com
ALLOWED_ORIGINS=*
